        </div>

        <div class="form-card">
          <form id="contactForm" novalidate>
            <div class="field" id="f-name">
              <label for="name">Nombre</label>
              <input id="name" name="name" type="text" autocomplete="name" placeholder="Cómo te llamamos" required>
              <p class="err" data-err></p>
            </div>
            <div class="field" id="f-phone">
              <label for="phone">Teléfono o WhatsApp</label>
              <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="10 dígitos" required>
              <p class="err" data-err></p>
            </div>
            <div class="field" id="f-service">
              <label for="service">¿Qué necesitas?</label>
              <select id="service" name="service">
                <option>Reparación de computadora o laptop</option>
                <option>Instalación de SSD o RAM</option>
                <option>Redes y Wi-Fi</option>
                <option>Cámaras de seguridad</option>
                <option>Compra de equipo o accesorios</option>
                <option>Mantenimiento para negocio</option>
                <option>Otro</option>
              </select>
            </div>
            <div class="field" id="f-message">
              <label for="message">Describe la falla</label>
              <textarea id="message" name="message" placeholder="Ej. La laptop tarda cinco minutos en abrir y se calienta mucho." required></textarea>
              <p class="err" data-err></p>
            </div>
            <button class="btn btn-primary" type="submit">Enviar solicitud</button>
            <p class="form-note">Se abre WhatsApp con tu mensaje listo. Nunca compartimos tus datos.</p>
            <p class="status" id="formStatus" role="status" aria-live="polite"></p>
          </form>
        </div>

      </div>
    </div>
  </section>
</main>

