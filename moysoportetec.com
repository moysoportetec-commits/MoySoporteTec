  <!-- PROCESO -->
  <section id="proceso">
    <div class="wrap">
      <div class="head">
        <h2>Cómo trabajamos</h2>
        <p>Cuatro pasos, sin sorpresas en la cuenta final.</p>
      </div>
      <div class="steps">
        <div class="step"><p class="step-n">Paso 1</p><h3>Nos cuentas la falla</h3><p>Por WhatsApp o teléfono. Con eso ya sabemos si conviene visita o traer el equipo.</p></div>
        <div class="step"><p class="step-n">Paso 2</p><h3>Revisamos sin costo</h3><p>Diagnóstico real del equipo o de la instalación antes de tocar nada.</p></div>
        <div class="step"><p class="step-n">Paso 3</p><h3>Autorizas el costo</h3><p>Te damos precio y tiempo por escrito. Si no te conviene, no se cobra la revisión.</p></div>
        <div class="step"><p class="step-n">Paso 4</p><h3>Entregamos probado</h3><p>Se entrega funcionando, con tus archivos intactos y garantía de 90 días.</p></div>
      </div>
    </div>
  </section>

