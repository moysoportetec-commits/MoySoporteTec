<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"LocalBusiness",
  "name":"MoySoporteTec",
  "description":"Soporte técnico, reparación de computadoras y laptops, redes Wi-Fi, cámaras de seguridad y venta de tecnología.",
  "url":"https://moysoportetec.com/",
  "email":"moysoportetec@gmail.com",
  "telephone":"+52 55 2063 2796",
  "sameAs":["https://www.instagram.com/moysoportetec/","https://www.facebook.com/moises.soportec?locale=es_LA","https://www.youtube.com/@moysoportetec"],
  "areaServed":"Ciudad de México",
  "openingHoursSpecification":[
    {"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday"],"opens":"09:00","closes":"18:00"},
    {"@type":"OpeningHoursSpecification","dayOfWeek":"Saturday","opens":"09:00","closes":"14:00"}
  ]
}
</script>

<script>
(function(){
  "use strict";

  /* ================= CONFIGURA AQUÍ =================
     whatsapp: número completo, solo dígitos, con lada de país.
     México: 52 + 10 dígitos  →  "525512345678"
  ==================================================== */
  var CONFIG = {
    whatsapp: "525520632796",                       // 52 + 10 dígitos
    whatsappDisplay: "55 2063 2796",                // cómo se muestra en la página
    email: "moysoportetec@gmail.com",
    zona: "Ciudad de México y zona conurbada · también damos soporte remoto",
    saludo: "Hola MoySoporteTec, quiero información sobre sus servicios."
  };

  var hasWa = /^\d{10,15}$/.test(CONFIG.whatsapp);
  function waUrl(text){
    return hasWa
      ? "https://wa.me/" + CONFIG.whatsapp + "?text=" + encodeURIComponent(text)
      : "mailto:" + CONFIG.email + "?subject=" + encodeURIComponent("Solicitud de servicio") + "&body=" + encodeURIComponent(text);
  }

  var $ = function(s,c){ return (c||document).querySelector(s); };
  var $$ = function(s,c){ return Array.prototype.slice.call((c||document).querySelectorAll(s)); };

  /* ---- Datos de contacto ---- */
  $("#year").textContent = new Date().getFullYear();
  $("#zoneText").textContent = CONFIG.zona;
  $("#mailLink").href = "mailto:" + CONFIG.email;
  $("#mailLink").textContent = CONFIG.email;

  var waLink = $("#waLink");
  waLink.textContent = CONFIG.whatsappDisplay || (hasWa ? "+" + CONFIG.whatsapp : "Agrega tu número en CONFIG");
  waLink.href = waUrl(CONFIG.saludo);
  $("#waFloat").href = waUrl(CONFIG.saludo);
  $("#navWa").href = waUrl(CONFIG.saludo);
  if (hasWa){ $("#waFloat").target = $("#navWa").target = "_blank"; $("#waFloat").rel = "noopener"; }

  /* ---- Header al hacer scroll ---- */
  var header = $("#header");
  var onScroll = function(){ header.classList.toggle("stuck", window.scrollY > 12); };
  onScroll();
  window.addEventListener("scroll", onScroll, {passive:true});

  /* ---- Menú móvil ---- */
  var burger = $("#burger"), links = $("#navLinks");
  burger.addEventListener("click", function(){
    var open = burger.getAttribute("aria-expanded") === "true";
    burger.setAttribute("aria-expanded", String(!open));
    burger.setAttribute("aria-label", open ? "Abrir menú" : "Cerrar menú");
    links.classList.toggle("open", !open);
  });
  $$("#navLinks a").forEach(function(a){
    a.addEventListener("click", function(){
      links.classList.remove("open");
      burger.setAttribute("aria-expanded","false");
    });
  });
  document.addEventListener("keydown", function(e){
    if (e.key === "Escape" && links.classList.contains("open")) burger.click();
  });

  /* ---- Enlace activo según la sección visible ---- */
  var navMap = {};
  $$('#navLinks a[href^="#"]').forEach(function(a){ navMap[a.getAttribute("href").slice(1)] = a; });
  if ("IntersectionObserver" in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        var a = navMap[en.target.id];
        if (!a) return;
        if (en.isIntersecting){
          $$('#navLinks a').forEach(function(x){ x.removeAttribute("aria-current"); });
          a.setAttribute("aria-current","true");
        }
      });
    }, {rootMargin:"-45% 0px -50% 0px"});
    $$("main section[id]").forEach(function(s){ io.observe(s); });
  }

  /* ---- Selector de problemas ---- */
  var PROBLEMAS = [
    "Va muy lento",
    "No enciende",
    "Se calienta o se apaga",
    "Pantalla dañada",
    "No carga la batería",
    "Virus o anuncios",
    "Recuperar archivos",
    "Wi-Fi que falla",
    "Instalar cámaras"
  ];
  var seleccion = [];
  var chipsBox = $("#chips"), sum = $("#quoteSum"), sendBtn = $("#quoteSend");

  PROBLEMAS.forEach(function(p){
    var b = document.createElement("button");
    b.type = "button";
    b.className = "chip";
    b.setAttribute("aria-pressed","false");
    b.innerHTML = '<span class="tick"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>' + p;
    b.addEventListener("click", function(){
      var on = b.getAttribute("aria-pressed") === "true";
      b.setAttribute("aria-pressed", String(!on));
      if (on) seleccion = seleccion.filter(function(x){ return x !== p; });
      else seleccion.push(p);
      render();
    });
    chipsBox.appendChild(b);
  });

  function render(){
    if (!seleccion.length){
      sum.textContent = "Aún no seleccionas nada.";
    } else {
      sum.innerHTML = "Vas a enviarnos: <b>" + seleccion.join(", ") + "</b>";
    }
    var texto = seleccion.length
      ? "Hola MoySoporteTec. Mi equipo tiene: " + seleccion.join(", ") + ". ¿Me pueden decir costo y tiempo?"
      : CONFIG.saludo;
    sendBtn.href = waUrl(texto);
    if (hasWa){ sendBtn.target = "_blank"; sendBtn.rel = "noopener"; }
  }
  render();

  /* ---- Botones de producto: prellenan el formulario ---- */
  $$("[data-producto]").forEach(function(btn){
    btn.addEventListener("click", function(){
      var sel = $("#service");
      sel.value = "Compra de equipo o accesorios";
      $("#message").value = "Me interesa: " + btn.getAttribute("data-producto") + ". ";
    });
  });

  /* ---- Formulario ---- */
  var form = $("#contactForm"), status = $("#formStatus");

  function setError(fieldId, msg){
    var f = $("#" + fieldId);
    f.classList.toggle("invalid", !!msg);
    $("[data-err]", f).textContent = msg || "";
    var input = $("input,textarea", f);
    if (input) input.setAttribute("aria-invalid", msg ? "true" : "false");
    return !msg;
  }

  form.addEventListener("submit", function(e){
    e.preventDefault();
    var name = $("#name").value.trim();
    var phone = $("#phone").value.replace(/\D/g,"");
    var service = $("#service").value;
    var message = $("#message").value.trim();

    var ok = true;
    ok = setError("f-name", name.length < 2 ? "Escribe tu nombre." : "") && ok;
    ok = setError("f-phone", phone.length < 10 ? "Necesitamos 10 dígitos para regresarte la llamada." : "") && ok;
    ok = setError("f-message", message.length < 10 ? "Cuéntanos un poco más de la falla." : "") && ok;

    if (!ok){
      status.className = "status warn show";
      status.textContent = "Revisa los campos marcados y vuelve a enviar.";
      var firstBad = $(".field.invalid input, .field.invalid textarea");
      if (firstBad) firstBad.focus();
      return;
    }

    var texto =
      "Hola MoySoporteTec.\n\n" +
      "Nombre: " + name + "\n" +
      "Teléfono: " + phone + "\n" +
      "Servicio: " + service + "\n" +
      "Falla: " + message;

    window.open(waUrl(texto), "_blank", "noopener");
    status.className = "status ok show";
    status.textContent = hasWa
      ? "Listo, abrimos WhatsApp con tu mensaje. Si no se abrió, escríbenos al número de arriba."
      : "Abrimos tu correo con la solicitud. También puedes escribirnos a " + CONFIG.email + ".";
    form.reset();
  });
})();
</script>
</body>
</html>
